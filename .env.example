# ==============================================================================
# HUMA HIJAB COLLECTION — FRONTEND STOREFRONT ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================
# Copy this file to .env.local for local development, or to .env.production for production deployment.

# ------------------------------------------------------------------------------
# API CONNECTION
# ------------------------------------------------------------------------------
# For local dev: http://localhost:5000/api/v1
# For production: https://api.humacollection.in/api/v1 (or reverse proxy /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Site URL for SEO, Canonical URLs, and Sitemap
NEXT_PUBLIC_SITE_URL=https://www.humacollection.in

# ------------------------------------------------------------------------------
# STORE BRANDING & DETAILS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Huma Hijab Collection"
NEXT_PUBLIC_STORE_TAGLINE="Luxury Burqas & Modest Fashion"
NEXT_PUBLIC_OWNER_NAME="Hamid Shaikh"

# ------------------------------------------------------------------------------
# PHYSICAL BOUTIQUE CONTACT & LOCATION (VYARA, GUJARAT)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_PHONE=8200617009
NEXT_PUBLIC_STORE_PHONE_FORMATTED="+91 82006 17009"
NEXT_PUBLIC_WHATSAPP="+918200617009"
NEXT_PUBLIC_MAPS_URL="https://www.google.com/maps/search/?api=1&query=Huma+Collection,+Near+Markaz+Masjid,+Vyara,+Gujarat+394650"
NEXT_PUBLIC_STORE_ADDRESS="Huma Collection, Near Markaz Masjid, Vyara, Gujarat 394650, India"

# ------------------------------------------------------------------------------
# ONLINE LAUNCH TIMELINE & SHOWCASE MODE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ONLINE_LAUNCH_DATE="November 2026"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Public Key)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_HumaHijab2026

# ------------------------------------------------------------------------------
# GOOGLE PLACES API (NEW) & GOOGLE MAPS CONFIGURATION
# ------------------------------------------------------------------------------
# Server-side API key for Google Places API (New) to fetch verified Google Reviews
# (Keep this strictly server-side - do NOT prefix with NEXT_PUBLIC_)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# The Google Place ID for Huma Collection in Vyara, Gujarat (e.g. ChIJ...)
# To find your Place ID: Visit https://developers.google.com/maps/documentation/places/web-service/place-id
# or search your Google Business Profile in Google Place ID Finder.
GOOGLE_PLACE_ID=your_google_place_id_here

# (Optional) Google Maps Embed API key if you wish to use the official Embed API
# By default, a zero-cost responsive Google Maps iframe embed is automatically used without requiring a key.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
