# Copy this file to .env.local for local development, or to .env.production for production deployment.

# ------------------------------------------------------------------------------
# API CONNECTION
# ------------------------------------------------------------------------------
# For local dev: http://localhost:5000/api/v1
# For production: https://api.humacollection.in/api/v1 (or reverse proxy /api/v1)
